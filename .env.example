# Selector universal de proveedor LLM (auto detecta cualquiera de las claves configuradas abajo)
# Opciones: auto | deepseek | openai | gemini | anthropic | opencode | openrouter | groq | ollama | custom
LLM_PROVIDER=auto
# Opcional: sobrescribe el modelo y/o endpoint de cualquier proveedor
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=

# 1) DeepSeek
DEEPSEEK_API_KEY=sk-tu-api-key-de-deepseek-aqui
DEEPSEEK_MODEL=deepseek-chat

# 2) OpenAI (GPT / o-series)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# 3) Google Gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# 4) Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# 5) OpenCode (Zen / Console)
# OPENCODE_API_KEY=...
# OPENCODE_MODEL=deepseek-v4.1-flash

# 6) OpenRouter / Groq / Ollama local
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Tipo de cambio referencial/oficial diario BCB (Bs por USD) - respaldo si no hay internet
TIPO_CAMBIO_BOB=11.83
